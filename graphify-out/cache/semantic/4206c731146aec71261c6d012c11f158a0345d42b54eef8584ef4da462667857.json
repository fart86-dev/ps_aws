{"nodes": [{"id": "llm_wiki_aws_runbooks_waf_bot_control_toggle_waf_bot_control_toggle_runbook", "label": "Runbook: WAF Bot Control Rule Toggle", "file_type": "document", "source_file": "llm-wiki/aws-runbooks/waf-bot-control-toggle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_runbooks_waf_bot_control_toggle_target_all_default_hazard", "label": "--target Defaults to all (dev + prod) Hazard", "file_type": "rationale", "source_file": "llm-wiki/aws-runbooks/waf-bot-control-toggle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Omitting --target disables the production ACL alongside dev, so the target must always be named explicitly."}, {"id": "llm_wiki_aws_runbooks_waf_bot_control_toggle_waf_acl_auto_backup", "label": "Automatic Full-ACL Backup Before Disable", "file_type": "concept", "source_file": "llm-wiki/aws-runbooks/waf-bot-control-toggle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UpdateWebACL is a LockToken-based wholesale replacement and AWS provides no rollback, so the JSON snapshot in backups/waf-acl/ is the only restore path. Deleting that folder destroys the ability to re-enable."}], "edges": [{"source": "llm_wiki_aws_runbooks_waf_bot_control_toggle_waf_bot_control_toggle_runbook", "target": "llm_wiki_aws_runbooks_waf_bot_control_toggle_target_all_default_hazard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-runbooks/waf-bot-control-toggle.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_runbooks_waf_bot_control_toggle_waf_bot_control_toggle_runbook", "target": "llm_wiki_aws_runbooks_waf_bot_control_toggle_waf_acl_auto_backup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-runbooks/