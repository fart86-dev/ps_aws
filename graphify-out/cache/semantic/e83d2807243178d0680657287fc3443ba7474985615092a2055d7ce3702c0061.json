, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_split_horizon_dns", "target": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_rds_privatization_design", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_buildtime_secret_baking", "target": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_ms_sam_toolchain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_buildtime_secret_baking", "target": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_ms_sam_s3_artifacts", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_buildtime_secret_baking", "target": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_plaintext_db_credentials", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_buildtime_secret_baking", "target": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_console_log_process_env", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_rds_privatization_design", "target": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_nat_gateway_requirement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_phase7_rds_public_disable", "target": "llm_wiki_gotchas_rds_waiter_notfound_pitfall", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_rds_privatization_design", "target": "llm_wiki_aws_pending_rds_privatization_roadmap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_rds_privatization_design", "target": "llm_wiki_decisions_protected_services_always_on", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_split_horizon_dns", "target": "llm_wiki_gotchas_split_horizon_dns_gotcha", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_buildtime_secret_baking", "target": "llm_wiki_gotchas_ms_sam_buildtime_secrets_gotcha", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "rds_privatization_phase_dependency_chain", "label": "Privatization Phase Dependency Chain (Observe, Gate, Migrate, Cut Over)", "nodes": ["llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_phase0_observability", "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_phase3_developer_access", "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_phase5_lambda_vpc_migration", "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_phase7_rds_public_disable", "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_rds_privatization_roadmap"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-30-vpc-rds-privatization-design.md"}]}