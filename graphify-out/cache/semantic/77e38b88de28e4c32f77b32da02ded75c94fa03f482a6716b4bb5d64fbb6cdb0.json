{"nodes": [{"id": "llm_wiki_aws_ops_2026_07_18_khj_dev_offboarding_khj_dev_offboarding", "label": "khj.dev IAM Offboarding (2026-07-18)", "file_type": "document", "source_file": "llm-wiki/aws-ops/2026-07-18-khj-dev-offboarding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_ops_2026_07_18_khj_dev_offboarding_app_data_store_group_restructure", "label": "app_data_store Group Restructure (Separation of Concerns)", "file_type": "rationale", "source_file": "llm-wiki/aws-ops/2026-07-18-khj-dev-offboarding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app_data_store bundled DynamoDB FullAccess with Textract and SecretsManager, so removing jejen205 to cut DynamoDB access would also cut unrelated Textract/SecretsManager work he actually used. Splitting the two concerns into a new doc_secrets group narrowed DynamoDB access to kimps alone while preserving both users' existing duties."}, {"id": "llm_wiki_aws_ops_2026_07_18_khj_dev_offboarding_doc_secrets_group", "label": "doc_secrets IAM Group (Textract + SecretsManager)", "file_type": "concept", "source_file": "llm-wiki/aws-ops/2026-07-18-khj-dev-offboarding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_ops_2026_07_18_khj_dev_offboarding_delete_user_policy_detach_requirement", "label": "delete-user Requires Detaching Directly Attached Policies", "file_type": "rationale", "source_file": "llm-wiki/aws-ops/2026-07-18-khj-dev-offboarding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clearing groups, access keys and SSH keys is not enough: managed and inline policies attached directly to the user also block delete-user with DeleteConflict. Checking only group membership leaves the deletion half-done."}], "edges": [{"sou