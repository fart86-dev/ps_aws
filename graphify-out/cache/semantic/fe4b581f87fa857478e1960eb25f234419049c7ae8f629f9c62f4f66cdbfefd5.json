{"nodes": [{"id": "llm_wiki_decisions_decisions", "label": "Decisions Log", "file_type": "document", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_decisions_wiki_primary_asset_aws_ops", "label": "AWS Operation History Is the Wiki's Primary Asset", "file_type": "rationale", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repo's real value is the record of what was done to account 306331009209 and with which commands; the Fastify+cron app is only tooling built on top. Commands that were not preserved are marked with a TODO question rather than guessed at."}, {"id": "llm_wiki_decisions_docs_folder_retirement", "label": "docs/ Retired \u2014 llm-wiki Is the Single Source of Truth", "file_type": "rationale", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping the same material in docs/ and the wiki guarantees one copy goes stale and the two diverge."}, {"id": "llm_wiki_decisions_protected_services_always_on", "label": "WAF / Security Hub / Config Must Stay Enabled", "file_type": "rationale", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The account was frozen on 2024-12-28 and AWS required these services to remain active as a condition of release; disabling them risks another freeze. Cost-reduction reviews must therefore never recommend turning them off. Removing only the Bot Control managed rule stays inside the permitted scope."}, {"id": "llm_wiki_decisions_cloudwatch_single_datapoint_decision", "label": "Keep the 5-Minute Single Datapoint", "file_type": "rationale", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CloudWatch publish lag can leave the window empty and the code falls back to value 0, making 'real zero' indistinguishable from 'no data'. Accepted because the 30-minute cadence means a missed tick is caught on the next one; revisit only when a single missed alert becomes unacceptable."}, {"id": "llm_wiki_decisions_dual_channel_notification", "label": "Send to Every Configured Channel", "file_type": "rationale", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rather than enforce a single channel-of-record, getActiveNotifiers fires everything that isConfigured. Per-environment selection then reduces to which env vars are filled. A complaint about duplicate alerts would require changing this behavior itself."}, {"id": "llm_wiki_decisions_hardcoded_thresholds", "label": "Thresholds Hardcoded, Not Env-Driven", "file_type": "rationale", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All environments use the same thresholds, so extracting them to env would add abstraction cost with no benefit."}, {"id": "llm_wiki_decisions_scheduler_auto_start", "label": "Scheduler Starts With the Server (No Off Switch)", "file_type": "rationale", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running cron inside the server process avoids a separate daemon and keeps stop management to a single PID. Side effect: local yarn dev also starts it, so a populated .env fires real alerts during development."}, {"id": "llm_wiki_decisions_bus_factor_one", "label": "bus_factor: 1", "file_type": "rationale", "source_file": "llm-wiki/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effectively one person knows this repo's intent, history and operational context, which is precisely why the wiki matters. Unknowns must be left as #todo rather than interpreted."}], "edges": [{"source": "llm_wiki_decisions_decisions", "target": "llm_wiki_decisions_wiki_primary_asset_aws_ops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/decisions.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_decisions_decisions", "target": "llm_wiki_decisions_docs_folder_retirement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/decisions.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_decisions_decisions", "target": "llm_wiki_decisions_protected_services_always_on", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/decisions.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_decisions_decisions", "target": "llm_wiki_decisions_cloudwatch_single_datapoint_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/decisions.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_decisions_decisions", "target": "llm_wiki_decisions_dual_channel_notification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/decisions.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_decisions_decisions", "target": "llm_wiki_decisions_hardcoded_thresholds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/decisions.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_decisions_decisions", "target": "llm_wiki_decisions_scheduler_auto_start", "relation": "references", "confidence": "EXTRACTED", "confiden