{"nodes": [{"id": "llm_wiki_aws_pending_aws_pending", "label": "AWS Pending / Follow-up Register", "file_type": "document", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_spd_test_chain", "label": "spd-test Chain Stop/Delete Decision", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "97.6% idle over 14 days, but it is the only one of the four RDS instances with a fixed service-managed EIP, which itself suggests an external partner may have whitelisted the address. That question must be resolved before Phase 7 touches it."}, {"id": "llm_wiki_aws_pending_dev_mshuttle_storage_migration", "label": "dev-mshuttle Storage Migration 200GB to 50GB", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_production_mshuttle_storage_shrink", "label": "production-mshuttle Source Storage Shrink 100GB to 25GB", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_hardcoded_access_keys", "label": "Hardcoded AWS Access Keys in cron_serv / driver-runn-cron", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owners identified by searching the literal key IDs: kimps, fart86 and an 'email' account. fart86 holds AdministratorAccess and its key drives the location-data nightly export pipeline, so a leak would compromise the whole account. Standard fix is switching to Lambda execution roles."}, {"id": "llm_wiki_aws_pending_root_account_iam_practice", "label": "Root Account Used for Routine IAM Work", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_runnupdateinput_removal", "label": "Remove Unused Geo Fields From RunnUpdateInput", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing exploits the field today, but the shared API_KEY means there is no per-field authorization, so leaving it open is unnecessary attack surface. Removing it lets the schema itself guarantee 'location data is read-only', which also helps the OPA argument."}, {"id": "llm_wiki_aws_pending_ttl_180day_deployment", "label": "TTL 180-Day Change Deployment Decision", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_ttl_design_intent", "label": "7-Day TTL Design-Intent Verification", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_rds_privatization_roadmap", "label": "RDS Full Privatization Roadmap (Pending Entry)", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_plaintext_credentials_immediate", "label": "Plaintext DB Credentials / process.env Logging (Immediate)", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_dynamodb_location_encryption", "label": "DynamoDB Location Data Encryption (OPA Response, Closed)", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_staging_cleanup", "label": "Staging Environment Decommission Cleanup", "file_type": "concept", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_pending_stack_unit_deletion_rule", "label": "Delete by Stack Unit, Never Individual Resources", "file_type": "rationale", "source_file": "llm-wiki/aws-pending.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adopted after the 2026-07-02 accidental DynamoDB deletion: deleting individual functions or resources instead of running delete-stack is what caused CDK-managed tables to be destroyed."}], "edges": [{"source": "llm_wiki_aws_pending_aws_pending", "target": "llm_wiki_aws_pending_spd_test_chain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-pending.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_pending_spd_test_chain", "target": "llm_wiki_aws_ops_2026_07_30_vpc_rds_privatization_design_rds_privatization_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-pending.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_pending_dev_mshuttle_storage_migration", "target": "llm_wiki_aws_runbooks_rds_shrink_migration_rds_shrink_migration_runbook", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-pending.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_pending_production_mshuttle_storage_shrink", "target": "llm_wiki_aws_runbooks_rds_shrink_migr