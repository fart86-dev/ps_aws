{"nodes": [{"id": "llm_wiki_gotchas_gotchas", "label": "Gotchas", "file_type": "document", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_rds_waiter_notfound_pitfall", "label": "RDS rename + waiter NotFound Pitfall", "file_type": "rationale", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AWS briefly returns NotFound while a rename is processing and the standard waiter fails immediately without retrying. A real incident cost 3-4 minutes of read-endpoint outage. Production work needs a hand-written polling loop that treats NotFound as retryable; the same applies to modify-db-instance --no-publicly-accessible in Phase 7."}, {"id": "llm_wiki_gotchas_split_horizon_dns_gotcha", "label": "Split-Horizon DNS Means Host Strings Survive Privatization", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_ms_sam_buildtime_secrets_gotcha", "label": "ms_sam Bakes Secrets at Build Time", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_ms_sam_bidirectional_param_validation", "label": "ms_sam Validates Parameters Bidirectionally", "file_type": "rationale", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "base-generator.cjs checks both that every template parameter exists in config and that every config parameter exists in the template. Adding SubnetIds/SecurityGroupIds to mssam.config.cjs without matching Parameters and Globals.Function.VpcConfig in template.yaml fails the deploy on the spot, which forces the Phase 5 change to be scripted as a codemod across 67 templates."}, {"id": "llm_wiki_gotchas_waf_metric_dimension_mismatch", "label": "WAF Metric Dimension Mismatch (REGIONAL vs GLOBAL)", "file_type": "rationale", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "monitorWAF lists REGIONAL Web ACLs but getMetricData hardcodes Region: GLOBAL, which is the CloudFront-scope dimension. The metric comes back empty and always reports 0, so WAF alerts may never have fired for reasons unrelated to the threshold."}, {"id": "llm_wiki_gotchas_cloudwatch_5min_datapoint_gotcha", "label": "5-Minute Single Datapoint Falls Back to Zero", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_stopped_ec2_zero_saving", "label": "stopped EC2 Savings Counted as Zero Everywhere", "file_type": "rationale", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "findStoppedEC2 hardcodes 0 on the comment that EBS is counted separately, but findUnattachedEBS only catches volumes with status available. A stopped instance's root volume stays attached, so it falls through both collectors and the monthly EBS charge never appears in the report total."}, {"id": "llm_wiki_gotchas_region_hardcoding_inconsistency", "label": "Region Hardcoding Differs Per Module", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_cloudtrail_90day_useast1", "label": "CloudTrail lookup-events: 90 Days and us-east-1 for IAM", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_iam_delete_user_checklist", "label": "IAM delete-user Pre-Deletion Checklist", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_agent_toolkit_global_side_effect", "label": "aws configure agent-toolkit Has Account-Global Side Effects", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_cloudfront_update_distribution_full_replace", "label": "update-distribution Is a Full PUT-Style Replacement", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_kms_pending_window", "label": "KMS 30-Day Pending Window Is the Only Safety Net", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_lambda_edge_useast1", "label": "Lambda@Edge Origin Functions Live in us-east-1", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_read_replica_allocated_storage", "label": "Read Replica Storage Cannot Be Smaller Than Source", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_appsync_updaterunn_geo_fields_gotcha", "label": "AppSync updateRunn Exposes Unused Geo Update Fields", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Not used today' is not the same as 'structurally blocked'. runn_hist is genuinely safe because of the attributeExists:false PutItem condition; production_dr_runn merely lacks a caller."}, {"id": "llm_wiki_gotchas_dynamodb_no_field_level_encryption", "label": "Location Tables Have No Field-Level Encryption", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changing SSE from an AWS-owned key to KMS can silently break the nightly S3 export and Streams consumers if their IAM roles lack kms:Decrypt, so consumer permissions must be verified before the switch."}, {"id": "llm_wiki_gotchas_flink_streams_consumer", "label": "Managed Flink Directly Subscribes to the Location Streams", "file_type": "concept", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_gotchas_driver_tracking_api_drift", "label": "driver-tracking-api-production Is Permanently Drifted", "file_type": "rationale", "source_file": "llm-wiki/gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto Scaling plus a legacy capacity cron change throughput live while the CDK template remembers static values, so the live stack always shows drift. The initial fear that deploying would reset capacity was wrong: CloudFormation diffs previous template against new template, not against live state, so untouched properties are excluded from the update. cdk diff answers 'what will actually change' more directly than detect-stack-drift, which only says 'something differs'."}], "edges": [{"source": "llm_wiki_gotchas_gotchas", "target": "llm_wiki_gotchas_rds_waiter_notfound_pitfall", "relation": "references", "confidence": "EXTRACTED", "c