{"nodes": [{"id": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_iam_grant_revoke_cloudtrail_audit", "label": "IAM Grant/Revoke CloudTrail Raw-Log Audit (2026-07-19)", "file_type": "document", "source_file": "llm-wiki/aws-ops/2026-07-19-iam-grant-revoke-cloudtrail-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_lookup_events_90day_useast1_limit", "label": "lookup-events 90-Day Limit + IAM Events Live in us-east-1", "file_type": "rationale", "source_file": "llm-wiki/aws-ops/2026-07-19-iam-grant-revoke-cloudtrail-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Event history API is capped at 90 days regardless of trail S3 retention, and IAM is global so events land in us-east-1. Querying from the account default region ap-northeast-2 silently returns zero results, which reads as 'no events' rather than 'wrong region'. Older history requires downloading raw gzip logs from the trail bucket."}, {"id": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_requestparameters_username_filtering", "label": "Filter on requestParameters.userName, Not userIdentity", "file_type": "rationale", "source_file": "llm-wiki/aws-ops/2026-07-19-iam-grant-revoke-cloudtrail-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain string grep for an account name matches every event that user performed (userIdentity.arn), producing large numbers of unrelated hits. Only requestParameters.userName identifies the account that was acted upon."}, {"id": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_root_account_iam_operations", "label": "Routine IAM Changes Performed by Root Account", "file_type": "concept", "source_file": "llm-wiki/aws-ops/2026-07-19-iam-grant-revoke-cloudtrail-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_iam_grant_revoke_cloudtrail_audit", "target": "llm_wiki_aws_ops_2026_07_18_khj_dev_offboarding_khj_dev_offboarding", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-19-iam-grant-revoke-cloudtrail-audit.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_lookup_events_90day_useast1_limit", "target": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_iam_grant_revoke_cloudtrail_audit", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-19-iam-grant-revoke-cloudtrail-audit.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_requestparameters_username_filtering", "target": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_iam_grant_revoke_cloudtrail_audit", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-19-iam-grant-revoke-cloudtrail-audit.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_iam_grant_revoke_cloudtrail_audit", "target": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_root_account_iam_operations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-ops/2026-07-19-iam-grant-revoke-cloudtrail-audit.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_ops_2026_07_19_iam_grant_revoke_cloudtrail_audit_root_account_iam_operations", "target": "llm_wiki_aws_pending_root_account_iam_practice", "relation": "references", "confidence":