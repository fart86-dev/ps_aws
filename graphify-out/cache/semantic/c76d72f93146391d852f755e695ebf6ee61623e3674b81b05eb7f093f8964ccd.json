{"nodes": [{"id": "llm_wiki_aws_runbooks_rds_shrink_migration_rds_shrink_migration_runbook", "label": "Runbook: RDS Storage Shrink via dump/restore Swap", "file_type": "document", "source_file": "llm-wiki/aws-runbooks/rds-shrink-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RDS storage can only grow, so shrinking requires building a smaller instance and moving the data into it."}, {"id": "llm_wiki_aws_runbooks_rds_shrink_migration_rename_swap_cutover", "label": "Rename-Swap Cutover", "file_type": "concept", "source_file": "llm-wiki/aws-runbooks/rds-shrink-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renaming old to -old and new to the original identifier keeps the endpoint FQDN unchanged so applications need no config change; DNS repoints within roughly 60 seconds. Matching the master password to the old one beforehand is what makes the swap transparent."}, {"id": "llm_wiki_aws_runbooks_rds_shrink_migration_final_snapshot_retention", "label": "Final Snapshot Retention Cost", "file_type": "concept", "source_file": "llm-wiki/aws-runbooks/rds-shrink-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "llm_wiki_aws_runbooks_rds_shrink_migration_rds_shrink_migration_runbook", "target": "llm_wiki_aws_runbooks_rds_shrink_migration_rename_swap_cutover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-runbooks/rds-shrink-migration.md", "source_location": null, "weight": 1.0}, {"source": "llm_wiki_aws_runbooks_rds_shrink_migration_rds_shrink_migration_runbook", "target": "llm_wiki_aws_runbooks_rds_shrink_migration_final_snapshot_retention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "llm-wiki/aws-runbooks/rds-sh